# ── FTP ──────────────────────────────────────────────────────────────────────
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=your_ftp_username
FTP_PASSWORD=your_ftp_password
FTP_DIR=/uploads          # Remote directory to scan for files

# ── Google Drive ──────────────────────────────────────────────────────────────
GDRIVE_FOLDER_ID=your_google_drive_folder_id

# Option A: paste the full service-account JSON as a single-line env var
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Option B: path to the service-account JSON file (local dev only)
# GOOGLE_CREDENTIALS_FILE=service_account.json

# ── Optional ──────────────────────────────────────────────────────────────────
UPLOADED_LOG=/tmp/uploaded_files.log   # Tracks uploaded filenames to skip re-uploads
